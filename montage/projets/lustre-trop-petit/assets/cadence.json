   "vitesse": 0.701,
   "debit_final": 5.5
  },
  {
   "texte": "perdu tout là-haut.",
   "syllabes": 5,
   "debit": 9.12,
   "vitesse": 0.603,
   "debit_final": 5.5
  },
  {
   "texte": "Alors, quelle taille choisir?",
   "syllabes": 6,
   "debit": 4.84,
   "vitesse": 1.136,
   "debit_final": 5.5
  },
  {
   "texte": "Pas besoin de calcul compliqué.",
   "syllabes": 9,
   "debit": 8.46,
   "vitesse": 0.65,
   "debit_final": 5.5
  },
  {
   "texte": "Pour un salon de vingt mètres carrés,",
   "syllabes": 9,
   "debit": 5.39,
   "vitesse": 1.02,
   "debit_final": 5.5
  },
  {
   "texte": "vise la largeur d'une porte.",
   "syllabes": 6,
   "debit": 5.58,
   "vitesse": 0.986,
   "debit_final": 5.5
  },
  {
   "texte": "Oui,",
   "syllabes": 1,
   "debit": 9.17,
   "vitesse": 0.75,
   "debit_final": 6.88
  },
  {
   "texte": "une vraie porte.",
   "syllabes": 3,
   "debit": 6.33,
   "vitesse": 0.869,
   "debit_final": 5.5
  },
  {
   "texte": "Ça paraît énorme, je sais.",
   "syllabes": 7,
   "debit": 7.78,
   "vitesse": 0.707,
   "debit_final": 5.5
  },
  {
   "texte": "Et pourtant,",
   "syllabes": 3,
   "debit": 8.45,
   "vitesse": 0.651,
   "debit_final": 5.5
  },
  {
   "texte": "c'est la bonne taille.",
   "syllabes": 4,
   "debit": 7.13,
   "vitesse": 0.771,
   "debit_final": 5.5
  },
  {
   "texte": "Sous un haut plafond,",
   "syllabes": 5,
   "debit": 6.35,
   "vitesse": 0.866,
   "debit_final": 5.5
  },
  {
   "texte": "vois",
   "syllabes": 1,
   "debit": 4.5,
   "vitesse": 1.2,
   "debit_final": 5.4
  },
  {
   "texte": "encore plus grand.",
   "syllabes": 4,
   "debit": 7.46,
   "vitesse": 0.737,
   "debit_final": 5.5
  },
  {
   "texte": "Mais sans exagérer:",
   "syllabes": 6,
   "debit": 7.92,
   "vitesse": 0.694,
   "debit_final": 5.5
  },
  {
   "texte": "un lustre géant écrase toute la pièce.",
   "syllabes": 8,
   "debit": 4.36,
   "vitesse": 1.261,
   "debit_final": 5.5
  },
  {
   "texte": "Tu hésites encore?",
