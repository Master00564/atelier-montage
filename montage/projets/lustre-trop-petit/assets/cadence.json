 "groupes": [
  {
   "texte": "Ton lustre est sûrement trop petit.",
   "syllabes": 9,
   "debit": 8.08,
   "vitesse": 0.681,
   "debit_final": 5.5
  },
  {
   "texte": "C'est l'une des erreurs les plus fréquentes, selon les pros de l'éclairage.",
   "syllabes": 17,
   "debit": 6.04,
   "vitesse": 0.911,
   "debit_final": 5.5
  },
  {
   "texte": "Trop petit, il se perd au plafond.",
   "syllabes": 9,
   "debit": 7.1,
   "vitesse": 0.775,
   "debit_final": 5.5
  },
  {
   "texte": "Trop grand,",
   "syllabes": 2,
   "debit": 5.39,
   "vitesse": 1.2,
   "debit_final": 6.47
  },
  {
   "texte": "il écrase toute la pièce.",
   "syllabes": 6,
   "debit": 5.84,
   "vitesse": 0.942,
   "debit_final": 5.5
  },
  {
   "texte": "Prends un mètre ruban:",
   "syllabes": 5,
   "debit": 6.88,
   "vitesse": 0.799,
   "debit_final": 5.5
  },
  {
   "texte": "trois règles suffisent pour tomber juste.",
   "syllabes": 9,
   "debit": 6.01,
   "vitesse": 0.915,
   "debit_final": 5.5
  },
  {
   "texte": "Un,",
   "syllabes": 1,
   "debit": 7.46,
   "vitesse": 0.75,
   "debit_final": 5.59
  },
  {
   "texte": "le diamètre.",
   "syllabes": 3,
   "debit": 5.73,
   "vitesse": 0.96,
   "debit_final": 5.5
  },
  {
   "texte": "Additionne la longueur et la largeur du salon,",
   "syllabes": 13,
   "debit": 6.44,
   "vitesse": 0.854,
   "debit_final": 5.5
  },
  {
   "texte": "en mètres,",
   "syllabes": 2,
   "debit": 5.62,
   "vitesse": 1.2,
   "debit_final": 6.74
  },
  {
   "texte": "puis multiplie par huit virgule trois.",
   "syllabes": 9,
   "debit": 6.21,
   "vitesse": 0.886,
   "debit_final": 5.5
  },
  {
   "texte": "Cinq mètres sur quatre?",
   "syllabes": 4,
   "debit": 5.18,
   "vitesse": 1.062,
   "debit_final": 5.5
  },
  {
   "texte": "Soixante-quinze centimètres,",
   "syllabes": 7,
   "debit": 6.36,
   "vitesse": 0.865,
   "debit_final": 5.5
  },
  {
   "texte": "presque la largeur d'une porte.",
   "syllabes": 7,
   "debit": 7.13,
   "vitesse": 0.771,
   "debit_final": 5.5
  },
  {
   "texte": "Et c'est un minimum:",
   "syllabes": 6,
   "debit": 7.86,
   "vitesse": 0.7,
   "debit_final": 5.5
  },
  {
   "texte": "sous un haut plafond,",
   "syllabes": 5,
   "debit": 5.35,
   "vitesse": 1.028,
   "debit_final": 5.5
  },
  {
   "texte": "vois plus grand.",
   "syllabes": 3,
   "debit": 8.36,
   "vitesse": 0.658,
   "debit_final": 5.5
  },
  {
   "texte": "Deux.",
   "syllabes": 1,
   "debit": 4.65,
   "vitesse": 1.2,
   "debit_final": 5.58
  },
  {
   "texte": "Au-dessus d'une table à manger,",
   "syllabes": 8,
   "debit": 9.07,
   "vitesse": 0.606,
   "debit_final": 5.5
  },
  {
   "texte": "il ne dépasse pas les deux tiers de sa largeur.",
   "syllabes": 12,
   "debit": 6.63,
   "vitesse": 0.83,
   "debit_final": 5.5
  },
  {
   "texte": "Une table de quatre-vingt-dix centimètres?",
   "syllabes": 10,
   "debit": 7.94,
   "vitesse": 0.693,
   "debit_final": 5.5
  },
  {
   "texte": "Soixante centimètres au maximum,",
   "syllabes": 9,
   "debit": 6.83,
   "vitesse": 0.805,
   "debit_final": 5.5
  },
  {
   "texte": "soit trente de moins que la table.",
   "syllabes": 7,
   "debit": 6.13,
   "vitesse": 0.897,
   "debit_final": 5.5
  },
  {
   "texte": "Plus large,",
   "syllabes": 2,
   "debit": 5.17,
   "vitesse": 1.2,
   "debit_final": 6.2
  },
  {
   "texte": "il déborde sur les convives.",
   "syllabes": 7,
   "debit": 7.56,
   "vitesse": 0.728,
   "debit_final": 5.5
  },
  {
   "texte": "Trois,",
   "syllabes": 1,
   "debit": 3.64,
   "vitesse": 1.2,
   "debit_final": 4.37
  },
  {
   "texte": "la hauteur.",
   "syllabes": 3,
   "debit": 5.59,
   "vitesse": 0.984,
   "debit_final": 5.5
  },
  {
   "texte": "Compte un cinquième à un quart de la hauteur sous plafond.",
   "syllabes": 14,
   "debit": 5.37,
   "vitesse": 1.024,
   "debit_final": 5.5
  },
  {
   "texte": "Sous deux mètres cinquante, la hauteur standard en France,",
   "syllabes": 12,
   "debit": 5.64,
   "vitesse": 0.975,
   "debit_final": 5.5
  },
  {
   "texte": "ça donne cinquante-deux à soixante-deux centimètres.",
   "syllabes": 14,
   "debit": 7.05,
   "vitesse": 0.78,
   "debit_final": 5.5
  },
  {
   "texte": "Mais garde deux mètres treize de passage dessous.",
   "syllabes": 10,
   "debit": 5.47,
   "vitesse": 1.005,
   "debit_final": 5.5
  },
  {
   "texte": "Il te reste alors",
   "syllabes": 5,
   "debit": 8.71,
   "vitesse": 0.631,
   "debit_final": 5.5
  },
  {
   "texte": "trente-sept centimètres, platine comprise.",
   "syllabes": 10,
   "debit": 6.02,
   "vitesse": 0.914,
   "debit_final": 5.5
  },
  {
   "texte": "La plus petite des deux mesures l'emporte:",
   "syllabes": 10,
   "debit": 7.35,
   "vitesse": 0.748,
   "debit_final": 5.5
  },
  {
   "texte": "sous un plafond bas,",
   "syllabes": 5,
   "debit": 6.75,
   "vitesse": 0.815,
   "debit_final": 5.5
  },
  {
   "texte": "prends un plafonnier.",
   "syllabes": 5,
   "debit": 7.86,
   "vitesse": 0.7,
   "debit_final": 5.5
  },
  {
   "texte": "Le guide complet est sur L'Atelier du Lustre point com.",
   "syllabes": 13,
   "debit": 5.96,
   "vitesse": 0.923,
   "debit_final": 5.5
  },
  {
   "texte": "Sans ces trois calculs,",
   "syllabes": 5,
   "debit": 5.6,
   "vitesse": 0.982,
   "debit_final": 5.5
  },
  {
   "texte": "on choisit trop souvent au coup de cœur.",
   "syllabes": 10,
   "debit": 5.73,
   "vitesse": 0.96,
   "debit_final": 5.5
  },
  {
   "texte": "Et c'est pour ça que",
