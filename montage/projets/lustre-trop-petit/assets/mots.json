 "phrases": [
  {
   "texte": "Ton lustre est sûrement trop petit.",
   "debut": 0.23,
   "fin": 2.2,
   "mots": [
    0,
    5
   ]
  },
  {
   "texte": "Et t'es pas le seul: c'est l'erreur la plus courante, d'après les pros de la lumière.",
   "debut": 2.364,
   "fin": 6.04,
   "mots": [
    6,
    21
   ]
  },
  {
   "texte": "Au plafond, il a l'air d'un bouton de chemise, perdu tout là-haut.",
   "debut": 6.621,
   "fin": 10.52,
   "mots": [
    22,
    33
   ]
  },
  {
   "texte": "Alors, quelle taille choisir?",
   "debut": 10.66,
   "fin": 11.52,
   "mots": [
    34,
    37
   ]
  },
  {
   "texte": "Pas besoin de calcul compliqué.",
   "debut": 11.859,
   "fin": 13.5,
   "mots": [
    38,
    42
   ]
  },
  {
   "texte": "Pour un salon de vingt mètres carrés, vise la largeur d'une porte.",
   "debut": 14.08,
   "fin": 16.72,
   "mots": [
    43,
    54
   ]
  },
  {
   "texte": "Oui, une vraie porte.",
   "debut": 16.932,
   "fin": 17.86,
   "mots": [
    55,
    58
   ]
  },
  {
   "texte": "Ça paraît énorme, je sais.",
   "debut": 18.042,
   "fin": 19.38,
   "mots": [
    59,
    63
   ]
  },
  {
   "texte": "Et pourtant, c'est la bonne taille.",
   "debut": 19.563,
   "fin": 21.16,
   "mots": [
    64,
    69
   ]
  },
  {
   "texte": "Sous un haut plafond, vois encore plus grand.",
   "debut": 21.292,
   "fin": 23.54,
   "mots": [
    70,
    77
   ]
  },
  {
   "texte": "Mais sans exagérer: un lustre géant écrase toute la pièce.",
   "debut": 23.729,
   "fin": 26.54,
   "mots": [
    78,
    87
   ]
  },
  {
   "texte": "Tu hésites encore?",
   "debut": 26.715,
   "fin": 27.68,
   "mots": [
    88,
    90
   ]
  },
  {
   "texte": "Découpe un rond de carton aussi large et scotche-le au plafond.",
   "debut": 27.886,
   "fin": 31.32,
   "mots": [
    91,
    101
   ]
  },
  {
   "texte": "Laisse-le un jour ou deux: tu sauras tout de suite si ça te plaît.",
   "debut": 31.389,
   "fin": 34.68,
   "mots": [
    102,
    115
   ]
  },
  {
   "texte": "Au-dessus de la table, c'est l'inverse: il doit rester moins large qu'elle, sinon tes invités dînent sous un parapluie.",
   "debut": 34.756,
   "fin": 40.52,
   "mots": [
    116,
    134
   ]
  },
  {
   "texte": "Dernier piège, et pas des moindres: la hauteur.",
   "debut": 40.68,
   "fin": 42.72,
   "mots": [
    135,
    142
   ]
  },
  {
   "texte": "Un grand gaillard de deux mètres doit passer dessous sans se cogner la tête.",
   "debut": 43.24,
   "fin": 46.36,
   "mots": [
    143,
    156
   ]
  },
  {
   "texte": "Oui, même le copain qui joue au basket.",
   "debut": 46.491,
   "fin": 48.46,
   "mots": [
    157,
    164
   ]
  },
  {
   "texte": "Chez toi, le plafond est bas?",
   "debut": 49.06,
   "fin": 50.14,
   "mots": [
    165,
    170
   ]
  },
  {
   "texte": "Oublie la suspension et prends un plafonnier: ta tête te dira merci.",
   "debut": 50.441,
   "fin": 54.4,
   "mots": [
    171,
    182
   ]
  },
  {
   "texte": "Sur nos fiches, un schéma donne les mesures exactes de chaque luminaire.",
   "debut": 54.4,
   "fin": 58.08,
   "mots": [
    183,
    194
   ]
  },
  {
   "texte": "Et tout le reste est dans notre guide gratuit, sur L'Atelier du Lustre point com.",
   "debut": 58.291,
   "fin": 61.98,
   "mots": [
    195,
    209
   ]
  },
  {
   "texte": "Alors, si tu as choisi le tien au coup de cœur, je parie que ton lustre est sûrement trop petit.",
   "debut": 62.034,
   "fin": 67.34,
   "mots": [
    210,
    229
   ]
  }
 ],
