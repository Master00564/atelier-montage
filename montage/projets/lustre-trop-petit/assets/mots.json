 "phrases": [
  {
   "texte": "Ton lustre est sûrement trop petit.",
   "debut": 0.24,
   "fin": 1.96,
   "mots": [
    0,
    5
   ]
  },
  {
   "texte": "Trop petit, il se perd au plafond.",
   "debut": 2.13,
   "fin": 4.14,
   "mots": [
    6,
    12
   ]
  },
  {
   "texte": "Trop grand, il écrase toute la pièce.",
   "debut": 4.217,
   "fin": 5.9,
   "mots": [
    13,
    19
   ]
  },
  {
   "texte": "Prends un mètre ruban: trois règles suffisent pour tomber juste.",
   "debut": 6.108,
   "fin": 8.9,
   "mots": [
    20,
    29
   ]
  },
  {
   "texte": "Un, le diamètre du lustre.",
   "debut": 9.109,
   "fin": 10.68,
   "mots": [
    30,
    34
   ]
  },
  {
   "texte": "Additionne la longueur et la largeur du salon, en mètres, puis multiplie par huit.",
   "debut": 10.96,
   "fin": 14.84,
   "mots": [
    35,
    48
   ]
  },
  {
   "texte": "Le résultat se lit directement en centimètres.",
   "debut": 15.107,
   "fin": 17.74,
   "mots": [
    49,
    55
   ]
  },
  {
   "texte": "Cinq mètres sur quatre?",
   "debut": 17.921,
   "fin": 18.74,
   "mots": [
    56,
    59
   ]
  },
  {
   "texte": "Neuf fois huit, soit soixante-douze centimètres.",
   "debut": 19.107,
   "fin": 21.62,
   "mots": [
    60,
    65
   ]
  },
  {
   "texte": "Pour qu'il devienne le point fort de la pièce, multiplie par dix: quatre-vingt-dix.",
   "debut": 21.783,
   "fin": 25.36,
   "mots": [
    66,
    78
   ]
  },
  {
   "texte": "Compare au diamètre hors tout, bras compris.",
   "debut": 25.864,
   "fin": 27.88,
   "mots": [
    79,
    85
   ]
  },
  {
   "texte": "Un modèle ouvert supporte même une taille au-dessus.",
   "debut": 28.08,
   "fin": 30.58,
   "mots": [
    86,
    93
   ]
  },
  {
   "texte": "Deux.",
   "debut": 30.984,
   "fin": 31.1,
   "mots": [
    94,
    94
   ]
  },
  {
   "texte": "Au-dessus d'une table à manger, il ne dépasse pas les deux tiers de sa largeur.",
   "debut": 31.1,
   "fin": 34.92,
   "mots": [
    95,
    109
   ]
  },
  {
   "texte": "Une table de quatre-vingt-dix centimètres?",
   "debut": 35.068,
   "fin": 36.88,
   "mots": [
    110,
    114
   ]
  },
  {
   "texte": "Soixante centimètres au maximum.",
   "debut": 37.321,
   "fin": 39.12,
   "mots": [
    115,
    118
   ]
  },
  {
   "texte": "Plus large, il déborde sur les convives.",
   "debut": 39.421,
   "fin": 41.34,
   "mots": [
    119,
    125
   ]
  },
  {
   "texte": "Si les deux règles divergent, suis toujours la table.",
   "debut": 41.555,
   "fin": 44.0,
   "mots": [
    126,
    134
   ]
  },
  {
   "texte": "Trois, la hauteur du lustre.",
   "debut": 44.206,
   "fin": 45.68,
   "mots": [
    135,
    139
   ]
  },
  {
   "texte": "Divise la hauteur sous plafond par cinq virgule cinq.",
   "debut": 45.77,
   "fin": 48.26,
   "mots": [
    140,
    148
   ]
  },
  {
   "texte": "Sous deux mètres cinquante de plafond, ça donne quarante-cinq centimètres, au plus.",
   "debut": 48.378,
   "fin": 52.22,
   "mots": [
    149,
    160
   ]
  },
  {
   "texte": "Mais garde aussi deux mètres quinze de passage libre dessous.",
   "debut": 52.386,
   "fin": 54.98,
   "mots": [
    161,
    170
   ]
  },
  {
   "texte": "Il te reste alors trente-cinq centimètres, platine comprise.",
   "debut": 55.06,
   "fin": 58.16,
   "mots": [
    171,
    178
   ]
  },
  {
   "texte": "La plus petite des deux mesures l'emporte.",
   "debut": 58.242,
   "fin": 60.1,
   "mots": [
    179,
    185
   ]
  },
  {
   "texte": "Sans ces trois calculs, on choisit trop souvent au coup de cœur.",
   "debut": 60.326,
   "fin": 63.26,
   "mots": [
    186,
    197
   ]
  },
  {
   "texte": "Et c'est pour ça que ton lustre est sûrement trop petit.",
   "debut": 63.474,
   "fin": 66.04,
   "mots": [
    198,
    208
   ]
  }
 ],
