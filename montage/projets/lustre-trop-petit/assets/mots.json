 "phrases": [
  {
   "texte": "Ton lustre est sûrement trop petit.",
   "debut": 0.223,
   "fin": 1.92,
   "mots": [
    0,
    5
   ]
  },
  {
   "texte": "C'est l'une des erreurs les plus fréquentes, selon les pros de l'éclairage.",
   "debut": 2.48,
   "fin": 5.36,
   "mots": [
    6,
    17
   ]
  },
  {
   "texte": "Trop petit, il se perd au plafond.",
   "debut": 5.528,
   "fin": 7.26,
   "mots": [
    18,
    24
   ]
  },
  {
   "texte": "Trop grand, il écrase toute la pièce.",
   "debut": 7.443,
   "fin": 9.18,
   "mots": [
    25,
    31
   ]
  },
  {
   "texte": "Prends un mètre ruban: trois règles suffisent pour tomber juste.",
   "debut": 9.309,
   "fin": 12.1,
   "mots": [
    32,
    41
   ]
  },
  {
   "texte": "Un, le diamètre.",
   "debut": 12.324,
   "fin": 13.4,
   "mots": [
    42,
    44
   ]
  },
  {
   "texte": "Additionne la longueur et la largeur du salon, en mètres, puis multiplie par huit virgule trois.",
   "debut": 13.78,
   "fin": 18.36,
   "mots": [
    45,
    60
   ]
  },
  {
   "texte": "Cinq mètres sur quatre?",
   "debut": 18.537,
   "fin": 19.32,
   "mots": [
    61,
    64
   ]
  },
  {
   "texte": "Soixante-quinze centimètres, presque la largeur d'une porte.",
   "debut": 20.12,
   "fin": 22.42,
   "mots": [
    65,
    71
   ]
  },
  {
   "texte": "Et c'est un minimum: sous un haut plafond, vois plus grand.",
   "debut": 22.684,
   "fin": 25.66,
   "mots": [
    72,
    82
   ]
  },
  {
   "texte": "Deux.",
   "debut": 25.89,
   "fin": 26.14,
   "mots": [
    83,
    83
   ]
  },
  {
   "texte": "Au-dessus d'une table à manger, il ne dépasse pas les deux tiers de sa largeur.",
   "debut": 26.362,
   "fin": 30.38,
   "mots": [
    84,
    98
   ]
  },
  {
   "texte": "Une table de quatre-vingt-dix centimètres?",
   "debut": 30.457,
   "fin": 32.24,
   "mots": [
    99,
    103
   ]
  },
  {
   "texte": "Soixante centimètres au maximum, soit trente de moins que la table.",
   "debut": 32.692,
   "fin": 35.86,
   "mots": [
    104,
    114
   ]
  },
  {
   "texte": "Plus large, il déborde sur les convives.",
   "debut": 36.086,
   "fin": 38.08,
   "mots": [
    115,
    121
   ]
  },
  {
   "texte": "Trois, la hauteur.",
   "debut": 38.151,
   "fin": 39.28,
   "mots": [
    122,
    124
   ]
  },
  {
   "texte": "Compte un cinquième à un quart de la hauteur sous plafond.",
   "debut": 39.427,
   "fin": 42.22,
   "mots": [
    125,
    135
   ]
  },
  {
   "texte": "Sous deux mètres cinquante, la hauteur standard en France, ça donne cinquante-deux à soixante-deux centimètres.",
   "debut": 42.286,
   "fin": 47.22,
   "mots": [
    136,
    150
   ]
  },
  {
   "texte": "Mais garde deux mètres treize de passage dessous.",
   "debut": 47.459,
   "fin": 49.4,
   "mots": [
    151,
    158
   ]
  },
  {
   "texte": "Il te reste alors trente-sept centimètres, platine comprise.",
   "debut": 49.565,
   "fin": 52.6,
   "mots": [
    159,
    166
   ]
  },
  {
   "texte": "La plus petite des deux mesures l'emporte: sous un plafond bas, prends un plafonnier.",
   "debut": 52.707,
   "fin": 56.78,
   "mots": [
    167,
    180
   ]
  },
  {
   "texte": "Le guide complet est sur L'Atelier du Lustre point com.",
   "debut": 57.038,
   "fin": 59.64,
   "mots": [
    181,
    190
   ]
  },
  {
   "texte": "Sans ces trois calculs, on choisit trop souvent au coup de cœur.",
   "debut": 59.693,
   "fin": 62.62,
   "mots": [
    191,
    202
   ]
  },
  {
   "texte": "Et c'est pour ça que ton lustre est sûrement trop petit.",
   "debut": 62.919,
   "fin": 65.62,
   "mots": [
    203,
    213
   ]
  }
 ],
